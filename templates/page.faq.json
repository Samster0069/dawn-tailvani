    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "row0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "icon": "truck",
            "row_content": "<p>Processing and delivery information varies by item. Check the product details, available checkout options and <a href=\"/policies/shipping-policy\">shipping policy</a>. Contact us with questions about a specific order.</p>",
            "page": ""
          }
        },
        "row1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is shipping free?",
            "icon": "price_tag",
            "row_content": "<p>Available shipping options and charges are shown at checkout. See our <a href=\"/policies/shipping-policy\">shipping policy</a> for details.</p>",
            "page": ""
          }
        },
        "row2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I track my order?",
            "icon": "box",
            "row_content": "<p>Check your order confirmation and order status page for available shipment updates. <a href=\"/pages/contact\">Contact us</a> if you need help finding tracking information.</p>",
            "page": ""
          }
        },
        "row3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "return",
            "row_content": "<p>Read our <a href=\"/policies/refund-policy\">return and refund policy</a> for eligibility and instructions. Contact us with your order number before sending an item back.</p>",
            "page": ""
          }
        },
        "row4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "My order arrived damaged or wrong. What should I do?",
            "icon": "question_mark",
            "row_content": "<p><a href=\"/pages/contact\">Contact us</a> with your order number, a description of the issue and clear photos. We will review the issue according to the <a href=\"/policies/refund-policy\">return and refund policy</a>.</p>",
            "page": ""
          }
        },
        "row5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I cancel or change my order?",
            "icon": "chat_bubble",
            "row_content": "<p><a href=\"/pages/contact\">Contact us</a> as soon as possible with your order number and requested change. Changes depend on the order status and cannot be guaranteed.</p>",
            "page": ""
          }
        },
        "row6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I choose a size?",
            "icon": "ruler",
            "row_content": "<p>Measure your pet's neck, chest and back length, then compare with the item's size chart and fit guidance. Sizing varies by item. Contact us if the correct size is unclear.</p>",
            "page": ""
          }
        },
        "row7": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you have a first-order discount?",
            "icon": "heart",
            "row_content": "<p>Yes. Use code WELCOME at checkout for 10% off your first order.</p>",
            "page": ""
          }
        }
      },
