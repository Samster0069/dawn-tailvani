{%- comment -%}
  Tailvani brand fonts, self-hosted from theme assets (SIL Open Font License):
  Young Serif (headings) by Bastien Sozeau; Figtree (body) by Erik Kennedy. Latin subset.
{%- endcomment -%}
<link rel="preload" as="font" href="{{ 'tv-young-serif.woff2' | asset_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ 'tv-figtree.woff2' | asset_url }}" type="font/woff2" crossorigin>
<style>
  @font-face { font-family: 'Young Serif'; font-style: normal; font-weight: 400; font-display: swap; src: url('{{ 'tv-young-serif.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'Figtree'; font-style: normal; font-weight: 400 700; font-display: swap; src: url('{{ 'tv-figtree.woff2' | asset_url }}') format('woff2'); }
  @font-face { font-family: 'Figtree'; font-style: italic; font-weight: 400; font-display: swap; src: url('{{ 'tv-figtree-italic.woff2' | asset_url }}') format('woff2'); }
</style>
