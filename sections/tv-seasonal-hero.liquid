{%- capture tv_skin_handle -%}{%- render 'tv-skin-handle' -%}{%- endcapture -%}
{%- assign tv_skin_handle = tv_skin_handle | strip -%}
{%- if tv_skin_handle != blank -%}
  {%- assign skin = metaobjects.tailvani_season_skin[tv_skin_handle] -%}
{%- endif -%}

{%- liquid
  assign art = section.settings.image
  assign art_mobile = section.settings.image_mobile
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign link_label = section.settings.link_label
  assign link_url = section.settings.link_url
  assign promo_label = ''
  assign promo_code = ''

  if skin != blank
    if skin.hero_image_desktop.value != blank
      assign art = skin.hero_image_desktop.value
    endif
    if skin.hero_image_mobile.value != blank
      assign art_mobile = skin.hero_image_mobile.value
    endif
    if section.settings.use_skin_copy
      if skin.hero_heading != blank
        assign heading = skin.hero_heading.value
      endif
      if skin.hero_subtext != blank
        assign subtext = skin.hero_subtext.value
      endif
      if skin.hero_button_label != blank
        assign button_label = skin.hero_button_label.value
      endif
      if skin.hero_collection.value != blank
        assign button_link = skin.hero_collection.value.url
      endif
      if skin.promo_label != blank
        assign promo_label = skin.promo_label.value
      endif
      if skin.promo_code != blank
        assign promo_code = skin.promo_code.value
      endif
    endif
  endif

  if art_mobile == blank
    assign art_mobile = art
  endif
  if button_link == blank and button_label != blank
    assign button_link = routes.all_products_collection_url
  endif
  assign show_primary = true
  assign show_secondary = true
  if section.settings.hide_empty_collection_links
    assign primary_path = button_link | split: '?' | first | split: '#' | first
    assign secondary_path = link_url | split: '?' | first | split: '#' | first
    if primary_path contains '/collections/'
      assign primary_handle = primary_path | split: '/collections/' | last | split: '/' | first
      assign primary_collection = collections[primary_handle]
      if primary_collection == blank or primary_collection.all_products_count == 0
        assign show_primary = false
      endif
    endif
    if secondary_path contains '/collections/'
      assign secondary_handle = secondary_path | split: '/collections/' | last | split: '/' | first
      assign secondary_collection = collections[secondary_handle]
      if secondary_collection == blank or secondary_collection.all_products_count == 0
        assign show_secondary = false
      endif
    endif
  endif
-%}

<section
  class="tv-hero color-{{ section.settings.color_scheme }} gradient"
  data-tv-skin="{{ tv_skin_handle }}"
  aria-labelledby="TvHeroHeading-{{ section.id }}"
>
  <div class="page-width tv-hero__grid">
    <div class="tv-hero__copy">
      {%- if promo_label != blank -%}
        <p class="tv-hero__promo">
          {{ promo_label | escape }}{% if promo_code != blank %}. Use code <strong>{{ promo_code | escape }}</strong>{% endif %}
        </p>
      {%- endif -%}
      <h1 id="TvHeroHeading-{{ section.id }}" class="tv-hero__heading">{{ heading | escape }}</h1>
      {%- if subtext != blank -%}
        <p class="tv-hero__sub">{{ subtext | escape | newline_to_br }}</p>
      {%- endif -%}
      <div class="tv-hero__actions">
        {%- if button_label != blank and show_primary -%}
          <a class="button button--primary" href="{{ button_link | escape }}">{{ button_label | escape }}</a>
        {%- endif -%}
        {%- if link_label != blank and link_url != blank and show_secondary -%}
          <a class="tv-link" href="{{ link_url | escape }}">{{ link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="tv-hero__art">
      {%- if art != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ art_mobile | image_url: width: 600 }} 600w, {{ art_mobile | image_url: width: 900 }} 900w"
            sizes="80vw"
          >
          {{
            art
            | image_url: width: 1320
            | image_tag:
              widths: '500, 700, 900, 1100, 1320',
              sizes: '(min-width: 990px) 46vw, (min-width: 750px) 50vw, 80vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: art.alt
          }}
        </picture>
      {%- else -%}
        <div class="tv-hero__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tailvani seasonal hero",
  "tag": "div",
  "class": "section tv-section-hero",
  "settings": [
    { "type": "paragraph", "content": "When a seasonal skin is active, its window art, heading, text, button and promo replace the defaults below. Edit skins in Content → Metaobjects → Tailvani season skin." },
    { "type": "image_picker", "id": "image", "label": "Default window art", "info": "Portrait art with a transparent background works best (1320 × 1560)." },
    { "type": "image_picker", "id": "image_mobile", "label": "Default window art (mobile)" },
    { "type": "text", "id": "heading", "label": "Default heading", "default": "A style for every tail" },
    { "type": "textarea", "id": "subtext", "label": "Default text", "default": "Clothing and accessories for cats and small dogs, with picks for every pet at home." },
    { "type": "text", "id": "button_label", "label": "Default button label", "default": "Shop new arrivals" },
    { "type": "url", "id": "button_link", "label": "Default button link" },
    { "type": "text", "id": "link_label", "label": "Secondary link label", "default": "Browse everything" },
    { "type": "url", "id": "link_url", "label": "Secondary link", "default": "/collections/all" },
    { "type": "checkbox", "id": "hide_empty_collection_links", "label": "Hide links to empty collections", "default": true },
    { "type": "checkbox", "id": "use_skin_copy", "label": "Use the seasonal skin's heading, text and button", "default": true, "info": "Turn off to keep this section's own words while still showing the seasonal art and colors." },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-2" }
  ],
  "presets": [ { "name": "Tailvani seasonal hero" } ]
}
{% endschema %}
